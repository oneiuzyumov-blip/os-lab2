
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ubuntu: Debug proctest (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/proctest",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build"
    },
    {
      "name": "Mac: Debug proctest (lldb)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/proctest",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    }
  ]
}
